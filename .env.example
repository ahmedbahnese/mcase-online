# Supabase pooled PostgreSQL connection string (server-only)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true
DB_POOL_MAX=5
NODE_ENV=production
FOUNDER_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
BASE_PATH=/
